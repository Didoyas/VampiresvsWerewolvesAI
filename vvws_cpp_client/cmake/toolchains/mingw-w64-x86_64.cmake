set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

set(MINGW_PREFIX "x86_64-w64-mingw32")
find_program(MINGW_CXX_COMPILER NAMES "${MINGW_PREFIX}-g++")
find_program(MINGW_RC_COMPILER NAMES "${MINGW_PREFIX}-windres")

if(NOT MINGW_CXX_COMPILER)
    message(FATAL_ERROR "Could not find ${MINGW_PREFIX}-g++. Install MinGW-w64 and ensure it is on PATH.")
endif()

set(CMAKE_CXX_COMPILER "${MINGW_CXX_COMPILER}")
if(MINGW_RC_COMPILER)
    set(CMAKE_RC_COMPILER "${MINGW_RC_COMPILER}")
endif()

# Search host tools on macOS, but Windows headers/libraries in the MinGW sysroot.
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
